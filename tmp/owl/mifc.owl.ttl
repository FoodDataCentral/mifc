@prefix PATO: <http://purl.obolibrary.org/obo/PATO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mifc: <https://w3id.org/FoodDataCentral/mifc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mifc:PersonCollection a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PersonCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mifc:Person ;
            owl:onProperty mifc:entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:entries ] ;
    skos:definition "A holder for Person objects" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:NamedThing a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mifc:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty mifc:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty mifc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty mifc:name ] ;
    skos:definition "A generic grouping for any identifiable entity" ;
    skos:exactMatch schema1:Thing ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:Person a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:primary_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\S+@[\\S+\\.]+\\S+" ] ) ] ;
            owl:onProperty mifc:primary_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:vital_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:birth_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:age_in_years ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:primary_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:vital_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Integer ;
            owl:onProperty mifc:age_in_years ],
        [ a owl:Restriction ;
            owl:allValuesFrom mifc:PersonStatus ;
            owl:onProperty mifc:vital_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Date ;
            owl:onProperty mifc:birth_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mifc:age_in_years ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mifc:birth_date ],
        mifc:NamedThing ;
    skos:definition "Represents a Person" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

PATO:0001421 a owl:Class,
        mifc:PersonStatus ;
    rdfs:label "ALIVE" ;
    rdfs:subClassOf mifc:PersonStatus ;
    skos:definition "the person is living" .

PATO:0001422 a owl:Class,
        mifc:PersonStatus ;
    rdfs:label "DEAD" ;
    rdfs:subClassOf mifc:PersonStatus ;
    skos:definition "the person is deceased" .

<https://w3id.org/FoodDataCentral/mifc/PersonStatus#UNKNOWN> a owl:Class,
        mifc:PersonStatus ;
    rdfs:label "UNKNOWN" ;
    rdfs:subClassOf mifc:PersonStatus ;
    skos:definition "the vital status is not known" .

mifc:entries a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "entries" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:age_in_years a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "age_in_years" ;
    rdfs:range linkml:Integer ;
    skos:definition "Number of years since birth" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:birth_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "birth_date" ;
    rdfs:range linkml:Date ;
    skos:definition "Date on which a person is born" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    skos:definition "A human-readable description for a thing" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "A unique identifier for a thing" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    skos:definition "A human-readable name for a thing" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:primary_email a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "primary_email" ;
    skos:definition "The main email address of a person" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:vital_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vital_status" ;
    rdfs:range mifc:PersonStatus ;
    skos:definition "living or dead status" ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> .

mifc:PersonStatus a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "PersonStatus" ;
    owl:unionOf ( PATO:0001421 PATO:0001422 <https://w3id.org/FoodDataCentral/mifc/PersonStatus#UNKNOWN> ) ;
    skos:inScheme <https://w3id.org/FoodDataCentral/mifc> ;
    linkml:permissible_values PATO:0001421,
        PATO:0001422,
        <https://w3id.org/FoodDataCentral/mifc/PersonStatus#UNKNOWN> .

<https://w3id.org/FoodDataCentral/mifc> a owl:Ontology ;
    rdfs:label "mifc" ;
    dcterms:license "MIT" ;
    dcterms:title "mifc" ;
    rdfs:seeAlso <https://FoodDataCentral.github.io/mifc> ;
    skos:definition "The Minimum Information (about any) Food Composition (MIFC), data standard." .

